{
  "manifest_version": 3,
  "name": "WIN5買い目メーカー",
  "version": "1.2.0",
  "description": "CSVのWIN5馬番を選択画面へ反映します。投票の確定は行いません。",
  "permissions": ["activeTab"],
  "host_permissions": ["https://www.ipat.jra.go.jp/2017/pw_890_i.cgi*", "http://localhost:8765/*"],
  "action": {
    "default_title": "WIN5買い目メーカー",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ipat.jra.go.jp/2017/pw_890_i.cgi*", "http://localhost:8765/*"],
      "js": ["content.js"]
    }
  ]
}
